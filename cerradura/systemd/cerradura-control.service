[Unit]
Description=Cerradura - proceso de control (servo, LCD, logs)
After=local-fs.target

[Service]
WorkingDirectory=/opt/cerradura
ExecStart=/opt/cerradura/venv/bin/python control.py
Restart=always
RestartSec=2
# Bitácora clase 8: apertura y decisión = prioridad alta (config.NICE_CONTROL)
Nice=-10

[Install]
WantedBy=multi-user.target
